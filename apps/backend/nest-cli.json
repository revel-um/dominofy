{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/backend/src",
  "entryFile": "main",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "src/heavy-lifter/*.*",
        "outDir": "dist/src/heavy-lifter",
        "watchAssets": true
      }
    ]
  }
}
