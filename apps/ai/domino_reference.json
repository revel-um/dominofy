[
    {
        "id": "llm",
        "label": "LLM",
        "category": "AI/LLM",
        "description": "Large Language Model integration with multiple providers.",
        "icon": "Cpu",
        "color": "blue",
        "features": [
            "Generate text completions using various AI models (GPT-4, Claude, Gemini, Mixtral)",
            "Support for multiple providers: OpenAI, Anthropic, Google, Mistral",
            "Configurable parameters: temperature, max tokens, top-p, frequency/presence penalties",
            "Streaming response support",
            "Dynamic prompt input via pin connection",
            "Model-specific token limits and capabilities"
        ],
        "fields": [
            {
                "heading": "Model",
                "type": "select",
                "required": true,
                "options": [
                    {
                        "label": "GPT-4o",
                        "value": "gpt-4o"
                    },
                    {
                        "label": "GPT-4 Turbo",
                        "value": "gpt-4-turbo"
                    },
                    {
                        "label": "GPT-3.5 Turbo",
                        "value": "gpt-3.5-turbo"
                    },
                    {
                        "label": "Claude 3 Opus",
                        "value": "claude-3-opus"
                    },
                    {
                        "label": "Claude 3 Sonnet",
                        "value": "claude-3-sonnet"
                    },
                    {
                        "label": "Gemini Pro",
                        "value": "gemini-pro"
                    },
                    {
                        "label": "Mixtral 8×7B",
                        "value": "mixtral-8x7b"
                    }
                ]
            },
            {
                "heading": "Prompt",
                "type": "textarea",
                "required": true,
                "inPinId": "value_in",
                "placeholder": "Enter your prompt…"
            },
            {
                "heading": "Temperature",
                "type": "number",
                "default": 0.7,
                "min": 0,
                "max": 2
            },
            {
                "heading": "Max Tokens",
                "type": "number",
                "default": 1000
            },
            {
                "heading": "Top P",
                "type": "number",
                "default": 1,
                "min": 0,
                "max": 1
            },
            {
                "heading": "Frequency Penalty",
                "type": "number",
                "default": 0,
                "min": -2,
                "max": 2
            },
            {
                "heading": "Presence Penalty",
                "type": "number",
                "default": 0,
                "min": -2,
                "max": 2
            },
            {
                "heading": "Stream",
                "type": "boolean",
                "default": false
            }
        ],
        "pins": {
            "exec_in": "EXEC_IN",
            "exec_out": "EXEC_OUT",
            "value_in": "VALUE_IN",
            "value_out": "VALUE_OUT"
        },
        "pinStructure": {
            "exec_in": true,
            "exec_out": true,
            "value_in": true,
            "value_out": "dynamic"
        },
