{
  "name": "dominofy",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run aws:local && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "start": "turbo run start",
    "aws:local": "docker compose -f aws-local.yml up -d"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/classnames": "^2.3.0",
    "@types/event-source-polyfill": "^1.0.5",
    "@types/passport-jwt": "^4.0.1",
    "turbo": "^2.5.0"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@xyflow/react": "^12.6.0",
    "axios": "^1.8.4",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "classnames": "^2.5.1",
    "event-source-polyfill": "^1.0.31",
    "p-limit": "^6.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "react-icons": "^5.5.0"
  }
}
